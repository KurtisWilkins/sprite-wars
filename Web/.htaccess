# Apache configuration for standard web hosting
# Place this file at the root of your hosted directory

# Enable CORS
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>

# Proper MIME types
<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType audio/ogg .ogg
    AddType audio/wav .wav
    AddType image/png .png
    AddType application/json .json
</IfModule>

# Caching for assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 day"
    ExpiresByType image/gif "access plus 1 day"
    ExpiresByType audio/ogg "access plus 1 day"
    ExpiresByType audio/wav "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 hour"
    ExpiresByType text/css "access plus 1 hour"
</IfModule>

# Rewrite root to game
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ /Web/index.html [L]
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
