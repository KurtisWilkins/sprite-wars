{
    "rewrites": [
        { "source": "/", "destination": "/Web/index.html" }
    ],
    "headers": [
        {
            "source": "/Sprites/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=86400" }
            ]
        },
        {
            "source": "/Audio/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=86400" }
            ]
        },
        {
            "source": "/Web/(.*).js",
            "headers": [
                { "key": "Content-Type", "value": "application/javascript" }
            ]
        }
    ]
}
