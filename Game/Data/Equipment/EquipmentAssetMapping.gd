## Get a flat list of all asset entries.
static func get_all_assets_flat() -> Array:
	var result: Array = []
	var by_cat := get_all_equipment_assets()
	for cat_key in by_cat:
		for entry in by_cat[cat_key]:
			var item := entry.duplicate()
			item["category"] = cat_key
			result.append(item)
	return result


## Get all asset entries for a specific category.
static func get_assets_for_category(category: String) -> Array:
	var all_assets := get_all_equipment_assets()
	return all_assets.get(category, [])


## Get all unique categories.
static func get_categories() -> Array:
	return get_all_equipment_assets().keys()
