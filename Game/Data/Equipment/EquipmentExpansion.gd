## Get count of expansion items.
static func get_expansion_count() -> int:
	return get_expanded_equipment().size()


## Get expansion items filtered by slot type.
static func get_by_slot(slot_type: String) -> Array:
	var result: Array = []
	for item in get_expanded_equipment():
		if item["slot_type"] == slot_type:
			result.append(item)
	return result


## Get expansion items filtered by rarity.
static func get_by_rarity(rarity: String) -> Array:
	var result: Array = []
	for item in get_expanded_equipment():
		if item["rarity"] == rarity:
			result.append(item)
	return result
